RELAYCAT_BOT_TOKEN=123456789:replace-with-bot-token
RELAYCAT_ADMIN_ID=123456789
RELAYCAT_ADMIN_PASSWORD=replace-with-a-strong-password
RELAYCAT_SECRET_KEY=replace-with-a-long-random-string

RELAYCAT_PORT=8765
RELAYCAT_COOKIE_SECURE=false

# Optional
RELAYCAT_BOT_ENABLED=true
RELAYCAT_ENABLE_FORWARDING=true
RELAYCAT_DROP_PENDING_UPDATES=false

# Cloudflare Turnstile (optional; configure all three values together)
# RELAYCAT_TURNSTILE_PUBLIC_URL=https://relaycat.example.com
# RELAYCAT_TURNSTILE_SITEKEY=0x4AAAAAA_your_public_sitekey
# RELAYCAT_TURNSTILE_VERIFY_URL=https://turnstile-siteverify-relaycat.example.workers.dev
